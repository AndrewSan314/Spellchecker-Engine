# Dependencies
node_modules/
# Python virtualenv created by `uv sync` (deps declared in pyproject.toml).
# uv.lock is intentionally NOT ignored — it pins the tool dependencies.
.venv/

# Python cache & bytecode
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/

# Process IDs & temporary logs
*.pid
*.log
.tmp/
.tmp*
*.tmp

# Legacy large dataset archives (> 90MB / non-runtime backups)
dataset_artifacts/lm/legacy-*/

# OS & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
